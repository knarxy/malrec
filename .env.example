# Local development. Copy to .env and keep it out of git.
POSTGRES_USER=malrec
POSTGRES_PASSWORD=malrec
POSTGRES_DB=malrec
POSTGRES_PORT=5433
API_PORT=8000

DATABASE_URL=postgresql://malrec:malrec@localhost:5433/malrec

MAL_CLIENT_ID=your-client-id
MAL_CLIENT_SECRET=your-client-secret
# Your MAL username: the admin (approves new accounts; comma-separate several)
# and the reference profile the monthly population refit is checked against.
ADMIN_USERS=your_mal_username
MALREC_USER=your_mal_username
# Encrypts stored MAL tokens. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_KEY=
APP_PORT=3000

# Sign in with MyAnimeList. MAL_REDIRECT_URI must exactly match the
# "App Redirect URL" registered at https://myanimelist.net/apiconfig
MAL_REDIRECT_URI=http://localhost:3000/api/auth/callback
APP_BASE_URL=http://localhost:3000
# true once served over HTTPS
SESSION_COOKIE_SECURE=false
