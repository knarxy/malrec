# malrec: nightly list sync of app users (so scores and status changes made on
# MyAnimeList itself reach the model), nightly database backup, weekly "coming
# soon" refresh (~30-60 MAL requests), monthly population refresh (scripts/).
# Install as /etc/cron.d/malrec on the server.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 3 1 * * root /opt/malrec/scripts/monthly_refresh.sh
15 4 * * * root /opt/malrec/scripts/backup.sh
# the MAL jobs share the refresh lock, so they never run at once (1 req/s total);
# each mails the admin its result or failure (malrec.notify)
45 3 * * 1 root /opt/malrec/scripts/weekly_upcoming.sh
15 3 * * * root /opt/malrec/scripts/nightly_sync.sh
